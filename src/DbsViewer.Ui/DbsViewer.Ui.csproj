<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Blazor WebAssembly UI pro DbsViewer. Publikovaný výstup se embeduje do DbsViewer.Server.</Description>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbsViewer.Abstractions\DbsViewer.Abstractions.csproj" />
    <ProjectReference Include="..\DbsViewer.Analysis\DbsViewer.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbsViewer.Ui.Tests" />
  </ItemGroup>

</Project>
