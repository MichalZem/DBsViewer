@*
    Nálezy porovnání EF modelu s databází. Seskupené podle závažnosti, protože
    „neaplikovaná migrace" a „index navíc" jsou dvě velmi různé zprávy.
*@

@if (Diff is null)
{
    <p class="nacita">@Texts.LoadingDiff</p>
}
else if (Diff.Findings.Count == 0)
{
    <div class="diff-cisty">
        <p class="ok">✓ @Texts.DiffClean</p>
    </div>
}
else
{
    <div class="diff">
        <header class="diff-souhrn">
            <span class="pocet chyba">@Counts.Errors(Diff.ErrorCount)</span>
            <span class="pocet varovani">@Counts.Warnings(Diff.WarningCount)</span>
        </header>

        @foreach (var group in Diff.Findings.GroupBy(static f => f.Severity))
        {
            <section class="@SeverityClass(group.Key)">
                <h3>@SeverityLabel(group.Key)</h3>

                <table class="mrizka">
                    <thead>
                        <tr>
                            <th>@Texts.ColumnObject</th>
                            <th>@Texts.ColumnFinding</th>
                            <th>@(Historical ? Texts.OlderVersion : Texts.Model)</th>
                            <th>@(Historical ? Texts.NewerVersion : Texts.Database)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var finding in group)
                        {
                            <tr>
                                <td class="jmeno">
                                    @if (finding.Table is { } table)
                                    {
                                        <button class="odkaz" @onclick="() => OnSelect.InvokeAsync(table)">
                                            @table.Qualified
                                        </button>
                                        @if (finding.Object is { } objekt)
                                        {
                                            <span class="podobjekt">.@objekt</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>@(finding.Object ?? Texts.SchemaLower)</span>
                                    }
                                </td>
                                <td>@Zprava(finding)</td>
                                <td class="mono">@(finding.ModelValue ?? "—")</td>
                                <td class="mono">@(finding.DatabaseValue ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </div>
}

@code {
    [Parameter]
    public SchemaDiff? Diff { get; set; }

    [Parameter]
    public EventCallback<DbObjectName> OnSelect { get; set; }

    /// <summary>
    /// Porovnávají se dvě verze historie, ne model proti databázi?
    /// </summary>
    /// <remarks>
    /// Nálezy jsou v obou případech stejné, ale slova ne: „sloupec je v databázi, ale
    /// v modelu není" dává smysl u driftu, kdežto v historii je to prostě „sloupec přibyl".
    /// Mění se jen popisky; data zůstávají tak, jak je spočítal porovnávač.
    /// </remarks>
    [Parameter]
    public bool Historical { get; set; }

    /// <summary>Popis nálezu. V historii se čte ve směru času.</summary>
    internal string Zprava(DiffFinding finding)
    {
        ArgumentNullException.ThrowIfNull(finding);

        return (Historical ? HistorickaZprava(finding.Kind) : null)
            ?? Zneni(finding.Kind)
            ?? finding.Message;
    }

    /// <summary>
    /// Překlad nálezu do řeči historie. „V modelu" je starší verze, „v databázi"
    /// novější — porovnávač dostává verze v tomhle pořadí.
    /// </summary>
    /// <summary>
    /// Věta k druhu nálezu.
    /// </summary>
    /// <remarks>
    /// Nález skládá server a jeho <c>Message</c> je vždy anglická — slouží HTTP API
    /// a nástroji <c>dbsview</c>. V prohlížečce se ale text sestaví znovu z <c>Kind</c>,
    /// aby šel přeložit. Neznámý druh spadne na serverovou větu, takže nový <c>DiffKind</c>
    /// nezpůsobí prázdný řádek.
    /// </remarks>
    internal static string? Zneni(DiffKind kind) => kind switch
    {
        DiffKind.TableMissingInDatabase => Texts.DiffTableMissingInDatabase,
        DiffKind.TableMissingInModel => Texts.DiffTableMissingInModel,
        DiffKind.ColumnMissingInDatabase => Texts.DiffColumnMissingInDatabase,
        DiffKind.ColumnMissingInModel => Texts.DiffColumnMissingInModel,
        DiffKind.ColumnTypeMismatch => Texts.DiffColumnTypeMismatch,
        DiffKind.ColumnNullabilityMismatch => Texts.DiffColumnNullabilityMismatch,
        DiffKind.ColumnLengthMismatch => Texts.DiffColumnLengthMismatch,
        DiffKind.ColumnDefaultMismatch => Texts.DiffColumnDefaultMismatch,
        DiffKind.PrimaryKeyMismatch => Texts.DiffPrimaryKeyMismatch,
        DiffKind.IndexMissingInDatabase => Texts.DiffIndexMissingInDatabase,
        DiffKind.IndexMissingInModel => Texts.DiffIndexMissingInModel,
        DiffKind.IndexUniquenessMismatch => Texts.DiffIndexUniquenessMismatch,
        DiffKind.IndexColumnsMismatch => Texts.DiffIndexColumnsMismatch,
        DiffKind.ForeignKeyMissingInDatabase => Texts.DiffForeignKeyMissingInDatabase,
        DiffKind.ForeignKeyMissingInModel => Texts.DiffForeignKeyMissingInModel,
        DiffKind.ForeignKeyTargetMismatch => Texts.DiffForeignKeyTargetMismatch,
        DiffKind.ForeignKeyDeleteBehaviorMismatch => Texts.DiffForeignKeyDeleteBehaviorMismatch,
        DiffKind.MigrationPending => Texts.DiffMigrationPending,
        DiffKind.MigrationOrphaned => Texts.DiffMigrationOrphaned,
        _ => null,
    };

    internal static string? HistorickaZprava(DiffKind kind) => kind switch
    {
        DiffKind.TableMissingInModel => Texts.HistoricalTableMissingInModel,
        DiffKind.TableMissingInDatabase => Texts.HistoricalTableMissingInDatabase,
        DiffKind.ColumnMissingInModel => Texts.HistoricalColumnMissingInModel,
        DiffKind.ColumnMissingInDatabase => Texts.HistoricalColumnMissingInDatabase,
        DiffKind.ColumnTypeMismatch => Texts.HistoricalColumnTypeMismatch,
        DiffKind.ColumnNullabilityMismatch => Texts.HistoricalColumnNullabilityMismatch,
        DiffKind.ColumnLengthMismatch => Texts.HistoricalColumnLengthMismatch,
        DiffKind.ColumnDefaultMismatch => Texts.HistoricalColumnDefaultMismatch,
        DiffKind.IndexMissingInModel => Texts.HistoricalIndexMissingInModel,
        DiffKind.IndexMissingInDatabase => Texts.HistoricalIndexMissingInDatabase,
        DiffKind.IndexUniquenessMismatch => Texts.HistoricalIndexUniquenessMismatch,
        DiffKind.IndexColumnsMismatch => Texts.HistoricalIndexColumnsMismatch,
        DiffKind.PrimaryKeyMismatch => Texts.HistoricalPrimaryKeyMismatch,
        DiffKind.ForeignKeyMissingInModel => Texts.HistoricalForeignKeyMissingInModel,
        DiffKind.ForeignKeyMissingInDatabase => Texts.HistoricalForeignKeyMissingInDatabase,
        DiffKind.ForeignKeyDeleteBehaviorMismatch => Texts.HistoricalForeignKeyDeleteBehaviorMismatch,
        DiffKind.ForeignKeyTargetMismatch => Texts.HistoricalForeignKeyTargetMismatch,

        // Stav migrací se mezi dvěma snapshoty neporovnává — původní zpráva sedí.
        _ => null,
    };

    internal static string SeverityLabel(DiffSeverity severity) => severity switch
    {
        DiffSeverity.Error => Texts.SeverityErrors,
        DiffSeverity.Warning => Texts.SeverityWarnings,
        _ => Texts.SeverityInfo,
    };

    internal static string SeverityClass(DiffSeverity severity) => severity switch
    {
        DiffSeverity.Error => "chyba",
        DiffSeverity.Warning => "varovani",
        _ => "info",
    };
}
