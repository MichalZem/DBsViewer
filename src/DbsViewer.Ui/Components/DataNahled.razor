@*
    Mřížka dat tabulky. Stránkuje, řadí i filtruje databáze — do prohlížečky se přenáší
    vždy jen jedna stránka, takže mřížka funguje stejně nad deseti řádky jako nad miliony.

    Když to server povolí, dá se v mřížce i zapisovat: hodnoty se upraví přímo v řádku
    a mazání se potvrzuje druhým kliknutím v témže řádku. Prohlížečka nikdy nenabídne to,
    co by server odmítl — o tom, co se smí měnit, rozhoduje sdílené RowEditing.

    U hodnoty, na kterou se odkazuje jiná tabulka, visí šipka na podřízené záznamy.
    Ta přepne mřížku na podřízenou tabulku omezenou právě na tenhle řádek — vazba se
    ukazuje nad daty jako štítek a dá se zrušit, aniž by uživatel přišel o vlastní filtry.
*@

@if (Error is { } chyba)
{
    <p class="chyba">@chyba</p>
}
else
{
    <div class="data-panel">

        <header class="data-lista">
            <div class="data-souhrn">
                @if (Preview is null)
                {
                    <span class="nacita">@Texts.LoadingData</span>
                }
                else if (Preview.TotalRows is { } celkem)
                {
                    <span>@Counts.Rows(celkem)</span>

                    @if (MaPodminku)
                    {
                        <span class="podminka">@Texts.AfterFilters</span>
                    }
                }
                else
                {
                    <span>Stránka @(Preview.Page + 1)</span>
                    <span class="podminka" title="@Texts.TotalCountUnknownTitle">@Texts.TotalCountUnknown</span>
                }
            </div>

            <div class="data-ovladani">
                <label>
                    @Texts.PageSize
                    <select value="@PageSize" @onchange="ZmenVelikost">
                        @foreach (var velikost in Velikosti)
                        {
                            <option value="@velikost">@velikost</option>
                        }
                    </select>
                </label>

                @if (MaFiltr)
                {
                    <button class="odkaz" @onclick="ZrusFiltry">@Texts.ClearFilters</button>
                }

                <button class="odkaz" @onclick="() => NactiAsync(Stranka)" title="@Texts.ReloadTitle">@Texts.Refresh</button>

                @if (MuzeVkladat && !NovyRadek)
                {
                    <button class="odkaz" @onclick="ZacniVkladani"
                            title="@Texts.NewRowTitle">@Texts.NewRow</button>
                }
            </div>
        </header>

        @if (ChybaZapisu is { } zapis)
        {
            <p class="chyba zapis-chyba">
                @zapis
                <button class="odkaz" @onclick="SkryjChybu" title="@Texts.HideMessage">@Texts.Close</button>
            </p>
        }

        @if (Link.Count > 0)
        {
            <p class="vazba-na-radek">
                <span class="stitek">@Texts.LinkedToRow</span>
                <span class="mono">@PopisVazby</span>
                <button class="odkaz" @onclick="ZrusVazbu"
                        title="@Texts.ShowWholeTable">@Texts.ShowWholeTable</button>
            </p>
        }

        @if (Preview is { MaskedColumns.Count: > 0 })
        {
            <p class="poznamka-maskovani">
                Zamaskované sloupce: @string.Join(", ", Preview.MaskedColumns)
            </p>
        }

        @if (JeZapisNabidnuty && Table is { } tabulka && !KlicJednoznacny)
        {
            <p class="poznamka-maskovani">
                Zapisovat se tu nedá — @DuvodBezKlice(tabulka).
            </p>
        }

        @if (Sloupce.Count > 0)
        {
            <div class="mrizka-obal">
                <table class="mrizka data">
                    <thead>
                        <tr class="hlavicky">
                            @if (JsouAkce)
                            {
                                <th class="akce" title="@Texts.RowActions"></th>
                            }
                            @foreach (var column in Sloupce)
                            {
                                <th class="@(IsMasked(column) ? "maskovany" : "")">
                                    <button class="razeni" @onclick="() => SeradAsync(column)"
                                            title="@Texts.SortBy @column">
                                        <span>@column</span>
                                        <span class="sipka">@SmerRazeni(column)</span>
                                    </button>
                                </th>
                            }
                        </tr>
                        <tr class="filtry">
                            @if (JsouAkce)
                            {
                                <th class="akce"></th>
                            }
                            @foreach (var column in Sloupce)
                            {
                                <th>
                                    <input type="search"
                                           class="@(Filtry.ContainsKey(column) ? "aktivni" : "")"
                                           placeholder="Filtr…"
                                           value="@(Filtry.GetValueOrDefault(column) ?? "")"
                                           @onchange="e => FiltrujAsync(column, e.Value?.ToString())" />
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody class="@(Nacita ? "nacita" : "")">
                        @if (NovyRadek)
                        {
                            <tr class="novy">
                                <td class="akce">
                                    <button class="odkaz ulozit" title="@Texts.InsertRowTitle"
                                            @onclick="VlozAsync">@Texts.Insert</button>
                                    <button class="odkaz" title="@Texts.DiscardNewRow"
                                            @onclick="Zrus">@Texts.Cancel</button>
                                </td>

                                @foreach (var sloupec in Sloupce)
                                {
                                    @if (DuvodNevyplnitelnosti(sloupec) is null)
                                    {
                                        <td class="upravovana">
                                            <input class="hodnota"
                                                   placeholder="@Vychozi(sloupec)"
                                                   value="@(Upravovana(sloupec) ?? "")"
                                                   disabled="@(Upravovana(sloupec) is null)"
                                                   aria-label="@sloupec"
                                                   @onchange="e => ZmenHodnotu(sloupec, e.Value?.ToString())" />

                                            @if (JeNullovatelny(sloupec))
                                            {
                                                <label class="null-prepinac" title="@Texts.StoreNull">
                                                    <input type="checkbox"
                                                           checked="@(Upravovana(sloupec) is null)"
                                                           @onchange="e => PrepniNull(sloupec, e.Value is true)" />
                                                    NULL
                                                </label>
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="neupravitelna" title="@DuvodNevyplnitelnosti(sloupec)">—</td>
                                    }
                                }
                            </tr>
                        }

                        @for (var r = 0; r < Radky.Count; r++)
                        {
                            var radek = r;
                            var row = Radky[radek];

                            <tr class="@StavRadku(radek)">
                                @if (JsouAkce)
                                {
                                    <td class="akce">
                                        @if (EditovanyRadek == radek)
                                        {
                                            <button class="odkaz ulozit" title="@Texts.SaveChanges"
                                                    @onclick="() => UlozAsync(radek)">@Texts.Save</button>
                                            <button class="odkaz" title="@Texts.DiscardChanges"
                                                    @onclick="Zrus">@Texts.Cancel</button>
                                        }
                                        else if (MazanyRadek == radek)
                                        {
                                            <span class="potvrzeni">@Texts.DeleteConfirm</span>
                                            <button class="odkaz nebezpecne" title="@Texts.DeleteReally"
                                                    @onclick="() => SmazAsync(radek)">@Texts.Yes</button>
                                            <button class="odkaz" @onclick="Zrus">@Texts.No</button>
                                        }
                                        else
                                        {
                                            @if (MuzeUpravovat)
                                            {
                                                <button class="odkaz" title="@Texts.EditRowTitle"
                                                        @onclick="() => ZacniUpravu(radek)">@Texts.Edit</button>
                                            }
                                            @if (MuzeMazat)
                                            {
                                                <button class="odkaz nebezpecne" title="@Texts.DeleteRowTitle"
                                                        @onclick="() => ZacniMazani(radek)">@Texts.Delete</button>
                                            }
                                        }
                                    </td>
                                }

                                @for (var c = 0; c < Math.Min(row.Count, Sloupce.Count); c++)
                                {
                                    var sloupec = Sloupce[c];
                                    var hodnota = row[c];

                                    @if (EditovanyRadek == radek && DuvodNeeditovatelnosti(sloupec) is null)
                                    {
                                        <td class="upravovana">
                                            <input class="hodnota"
                                                   value="@(Upravovana(sloupec) ?? "")"
                                                   disabled="@(Upravovana(sloupec) is null)"
                                                   aria-label="@sloupec"
                                                   @onchange="e => ZmenHodnotu(sloupec, e.Value?.ToString())" />

                                            @if (JeNullovatelny(sloupec))
                                            {
                                                <label class="null-prepinac" title="@Texts.StoreNull">
                                                    <input type="checkbox"
                                                           checked="@(Upravovana(sloupec) is null)"
                                                           @onchange="e => PrepniNull(sloupec, e.Value is true)" />
                                                    NULL
                                                </label>
                                            }
                                        </td>
                                    }
                                    else if (EditovanyRadek == radek)
                                    {
                                        <td class="neupravitelna @(hodnota is null ? "nullova" : "")"
                                            title="@DuvodNeeditovatelnosti(sloupec)">@(hodnota ?? "NULL")</td>
                                    }
                                    else
                                    {
                                        <td class="@(hodnota is null ? "nullova" : "")">
                                            @(hodnota ?? "NULL")

                                            @if (OdkazyU(sloupec, radek) is { Count: > 0 } odkazy)
                                            {
                                                <span class="deti">
                                                    <button class="ikona-deti" title="@Texts.ChildRowsTitle"
                                                            aria-label="@Texts.ChildRows"
                                                            @onclick="() => OtevriDetiAsync(radek, sloupec, odkazy)">⤷</button>

                                                    @if (JeNabidkaOtevrena(radek, sloupec))
                                                    {
                                                        <ul class="nabidka-deti">
                                                            <li class="nadpis">@Texts.ChildRowsPick</li>
                                                            @foreach (var odkaz in odkazy)
                                                            {
                                                                <li>
                                                                    <button class="odkaz"
                                                                            @onclick="() => SkocAsync(odkaz, radek)">@Popis(odkaz)</button>
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </span>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            @if (Radky.Count == 0 && !Nacita)
            {
                <p class="prazdno">
                    @(MaPodminku ? Texts.NoRowsMatchFilter : Texts.TableEmpty)
                </p>
            }
        }

        @if (Preview is { } nahled && (nahled.Page > 0 || nahled.HasMore))
        {
            <nav class="strankovani">
                <button disabled="@(nahled.Page == 0 || Nacita)" @onclick="() => NactiAsync(0)"
                        title="@Texts.FirstPage">«</button>
                <button disabled="@(nahled.Page == 0 || Nacita)" @onclick="() => NactiAsync(nahled.Page - 1)">
                    ‹ Předchozí
                </button>

                <span class="pozice">
                    @if (nahled.PageCount is { } stranek)
                    {
                        @($"{Texts.Page} {Plural.Number(nahled.Page + 1)} / {Plural.Number(stranek)}")
                    }
                    else
                    {
                        @($"{Texts.Page} {Plural.Number(nahled.Page + 1)}")
                    }
                </span>

                <button disabled="@(!nahled.HasMore || Nacita)" @onclick="() => NactiAsync(nahled.Page + 1)">
                    Další ›
                </button>
                <button disabled="@(nahled.PageCount is null || !nahled.HasMore || Nacita)"
                        @onclick="() => NactiAsync((int)(nahled.PageCount!.Value - 1))"
                        title="@Texts.LastPage">»</button>
            </nav>
        }
    </div>
}

@code {
    /// <summary>Nabízené velikosti stránky.</summary>
    private static readonly int[] Velikosti = [25, 50, 100, 250];

    private Dictionary<string, string> Filtry { get; } = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Rozepsané hodnoty upravovaného řádku. Hodnota <c>null</c> znamená NULL.</summary>
    private Dictionary<string, string?> Editace { get; } = new(StringComparer.OrdinalIgnoreCase);

    private int Stranka { get; set; }

    private int PageSize { get; set; } = 50;

    private string? SloupecRazeni { get; set; }

    private bool RaditSestupne { get; set; }

    private bool Nacita { get; set; }

    private DbObjectName? NactenaTabulka { get; set; }

    /// <summary>Index upravovaného řádku na aktuální stránce.</summary>
    private int? EditovanyRadek { get; set; }

    /// <summary>Index řádku, u kterého se čeká na potvrzení smazání.</summary>
    private int? MazanyRadek { get; set; }

    /// <summary>Je nad mřížkou rozepsaný nový řádek?</summary>
    private bool NovyRadek { get; set; }

    /// <summary>Proč se poslední zápis nepovedl. Mřížka zůstane, hláška je nad ní.</summary>
    private string? ChybaZapisu { get; set; }

    /// <summary>Vazba, se kterou je načtená stránka. Její změna znamená jiná data.</summary>
    private string NactenaVazba { get; set; } = "";

    /// <summary>Řádek a sloupec s rozbalenou nabídkou podřízených tabulek.</summary>
    private (int Radek, string Sloupec)? Nabidka { get; set; }

    [Parameter]
    public DbTable? Table { get; set; }

    [Parameter]
    public RowPreview? Preview { get; set; }

    [Parameter]
    public string? Error { get; set; }

    /// <summary>Povolil server úpravu hodnot?</summary>
    [Parameter]
    public bool CanEdit { get; set; }

    /// <summary>Povolil server mazání řádků?</summary>
    [Parameter]
    public bool CanDelete { get; set; }

    /// <summary>Povolil server zakládání nových řádků?</summary>
    [Parameter]
    public bool CanInsert { get; set; }

    /// <summary>
    /// Odkazy z téhle tabulky na podřízené záznamy. Prázdné, když na tabulku nic neukazuje.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ChildLink> Links { get; set; } = [];

    /// <summary>
    /// Vazba na nadřazený řádek. Prázdné znamená celou tabulku.
    /// </summary>
    /// <remarks>
    /// Je to podmínka navíc nad filtry, které si uživatel naťuká v hlavičce: přijde
    /// z adresy, ukazuje se nad mřížkou jako štítek a ruší se zvlášť. Kdyby se míchala
    /// s políčky filtrů, uživatel by ji nedopatřením smazal a nevěděl by, proč najednou
    /// vidí celou tabulku.
    /// </remarks>
    [Parameter]
    public IReadOnlyList<ChildFilter> Link { get; set; } = [];

    /// <summary>Načtení stránky. Komponenta si sama neví, jak volat server.</summary>
    [Parameter]
    public EventCallback<DataQuery> OnLoad { get; set; }

    /// <summary>Přechod na podřízené záznamy jednoho řádku.</summary>
    [Parameter]
    public EventCallback<ChildJump> OnShowChildren { get; set; }

    /// <summary>Zrušení vazby na nadřazený řádek.</summary>
    [Parameter]
    public EventCallback OnClearLink { get; set; }

    /// <summary>
    /// Uložení změn. Vrací chybovou hlášku, nebo <c>null</c>, když se zápis povedl.
    /// </summary>
    /// <remarks>
    /// Není to <c>EventCallback</c> schválně: mřížka musí vědět, jak zápis dopadl,
    /// aby políčka zavřela až po úspěchu a jinak rozepsané hodnoty neztratila.
    /// </remarks>
    [Parameter]
    public Func<DataUpdate, Task<string?>>? OnUpdate { get; set; }

    /// <summary>Smazání řádku. Vrací chybovou hlášku, nebo <c>null</c> při úspěchu.</summary>
    [Parameter]
    public Func<DataDelete, Task<string?>>? OnDelete { get; set; }

    /// <summary>Vložení řádku. Vrací chybovou hlášku, nebo <c>null</c> při úspěchu.</summary>
    [Parameter]
    public Func<DataInsert, Task<string?>>? OnInsert { get; set; }

    private bool MaFiltr => Filtry.Count > 0;

    /// <summary>Je výpis něčím omezený — vlastním filtrem, nebo vazbou na nadřazený řádek?</summary>
    private bool MaPodminku => MaFiltr || Link.Count > 0;

    /// <summary>Vazba jako text pro štítek nad mřížkou.</summary>
    private string PopisVazby =>
        string.Join(", ", Link.Select(static o => $"{o.Column} = {o.Value}"));

    /// <summary>
    /// Sloupce mřížky. Dokud data nedorazila, berou se ze schématu, aby hlavičky
    /// i filtry byly na místě hned a mřížka se pod rukama nepřeskládala.
    /// </summary>
    private IReadOnlyList<string> Sloupce =>
        Preview is { Columns.Count: > 0 } nahled
            ? nahled.Columns
            : Table?.Columns.Select(static c => c.Name).ToList() ?? [];

    private IReadOnlyList<IReadOnlyList<string?>> Radky => Preview?.Rows ?? [];

    /// <summary>Nabízí konfigurace zápis, ať už v téhle tabulce půjde, nebo ne?</summary>
    private bool JeZapisNabidnuty =>
        (CanEdit && OnUpdate is not null)
        || (CanDelete && OnDelete is not null)
        || (CanInsert && OnInsert is not null);

    /// <summary>Dá se řádek jednoznačně adresovat? Bez toho se nezapisuje vůbec.</summary>
    private bool KlicJednoznacny =>
        Table is { } tabulka && RowEditing.CanIdentifyRows(tabulka, Preview?.MaskedColumns);

    private bool MuzeUpravovat => CanEdit && OnUpdate is not null && KlicJednoznacny;

    private bool MuzeMazat => CanDelete && OnDelete is not null && KlicJednoznacny;

    /// <summary>
    /// Vkládat jde i tam, kde se upravovat nedá: nový řádek se neadresuje klíčem, takže
    /// stačí, že to není pohled.
    /// </summary>
    private bool MuzeVkladat =>
        CanInsert && OnInsert is not null && Table is { } tabulka && RowEditing.CanInsertRows(tabulka);

    private bool JsouAkce => MuzeUpravovat || MuzeMazat || MuzeVkladat;

    /// <summary>
    /// Data se načtou hned při zobrazení, při přepnutí na jinou tabulku a při změně
    /// vazby na nadřazený řádek — ta mění, které řádky do mřížky vůbec patří.
    /// </summary>
    /// <remarks>
    /// Filtry a řazení přežijí změnu vazby, ale ne změnu tabulky: sloupce jsou v každé
    /// tabulce jiné, kdežto skok na jiného rodiče téže tabulky nechává mřížku beze změny
    /// a zahodit v ní rozepsané filtry by uživatele okradlo o práci.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        var vazba = KlicVazby();

        if (Table is null || (Table.Name == NactenaTabulka && vazba == NactenaVazba))
        {
            return;
        }

        if (Table.Name != NactenaTabulka)
        {
            Filtry.Clear();
            SloupecRazeni = null;
            RaditSestupne = false;
        }

        NactenaTabulka = Table.Name;
        NactenaVazba = vazba;
        ChybaZapisu = null;

        await NactiAsync(0);
    }

    /// <summary>Vazba jako jeden řetězec, aby se dala porovnat s tou načtenou.</summary>
    private string KlicVazby() =>
        string.Join("\n", Link.Select(static o => $"{o.Column}={o.Value}"));

    private async Task NactiAsync(int stranka)
    {
        if (Nacita)
        {
            return;
        }

        // Rozepsaná úprava platí pro řádky, které jsou právě v mřížce. Po načtení jiných
        // by seděla na jiná data, takže se zahodí.
        Zrus();

        Stranka = Math.Max(stranka, 0);
        Nacita = true;

        try
        {
            await OnLoad.InvokeAsync(Dotaz());
        }
        finally
        {
            Nacita = false;
        }
    }

    /// <summary>Současný stav mřížky jako požadavek pro server.</summary>
    internal DataQuery Dotaz() => new()
    {
        Page = Stranka,
        PageSize = PageSize,
        SortColumn = SloupecRazeni,
        SortDescending = RaditSestupne,

        // Vazba na nadřazený řádek jde na přesnou shodu — je to cizí klíč, ne hledání.
        // Do políčka se naopak píše hledaný text, takže se z něj stane „obsahuje".
        Filters =
        [
            .. Link.Select(static o => new DataFilter(o.Column, FilterOperator.Equals, o.Value)),
            .. Filtry.Select(static f => new DataFilter(f.Key, FilterOperator.Contains, f.Value)),
        ],
    };

    /// <summary>Kliknutí na hlavičku: vzestupně, sestupně, bez řazení.</summary>
    private async Task SeradAsync(string column)
    {
        if (!string.Equals(SloupecRazeni, column, StringComparison.OrdinalIgnoreCase))
        {
            SloupecRazeni = column;
            RaditSestupne = false;
        }
        else if (!RaditSestupne)
        {
            RaditSestupne = true;
        }
        else
        {
            SloupecRazeni = null;
            RaditSestupne = false;
        }

        // Po změně řazení se čísla stránek posunou, takže se začíná od první.
        await NactiAsync(0);
    }

    private async Task FiltrujAsync(string column, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            Filtry.Remove(column);
        }
        else
        {
            Filtry[column] = value.Trim();
        }

        await NactiAsync(0);
    }

    private async Task ZrusFiltry()
    {
        Filtry.Clear();
        await NactiAsync(0);
    }

    private async Task ZmenVelikost(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var velikost))
        {
            PageSize = velikost;
            await NactiAsync(0);
        }
    }

    internal string SmerRazeni(string column) =>
        string.Equals(SloupecRazeni, column, StringComparison.OrdinalIgnoreCase)
            ? RaditSestupne ? "▾" : "▴"
            : "";

    private bool IsMasked(string column) =>
        Preview is not null
        && Preview.MaskedColumns.Contains(column, StringComparer.OrdinalIgnoreCase);

    // ---------- zápis ----------

    /// <summary>Proč se v téhle tabulce nedá adresovat řádek.</summary>
    internal static string DuvodBezKlice(DbTable table) => table switch
    {
        { IsView: true } => Texts.ReasonView,
        { PrimaryKey: null or { Columns.Count: 0 } } => Texts.ReasonNoPrimaryKey,
        _ => Texts.ReasonKeyNotReadable,
    };

    /// <summary>Proč se hodnota sloupce nedá měnit, nebo <c>null</c>, když měnit jde.</summary>
    internal string? DuvodNeeditovatelnosti(string column) =>
        Table?.FindColumn(column) is { } sloupec
            ? RowEditing.ReadOnlyReason(sloupec, Preview?.MaskedColumns)
            : Texts.ReasonColumnMissing;

    private bool JeNullovatelny(string column) => Table?.FindColumn(column) is { IsNullable: true };

    private string StavRadku(int radek) =>
        EditovanyRadek == radek ? "upravuje-se" : MazanyRadek == radek ? "maze-se" : "";

    /// <summary>Rozepsaná hodnota sloupce. <c>null</c> znamená NULL.</summary>
    private string? Upravovana(string column) => Editace.GetValueOrDefault(column);

    private void SkryjChybu() => ChybaZapisu = null;

    private void ZacniUpravu(int radek)
    {
        Zrus();
        EditovanyRadek = radek;

        var row = Radky[radek];

        for (var i = 0; i < Math.Min(row.Count, Sloupce.Count); i++)
        {
            if (DuvodNeeditovatelnosti(Sloupce[i]) is null)
            {
                Editace[Sloupce[i]] = row[i];
            }
        }
    }

    private void ZacniMazani(int radek)
    {
        Zrus();
        MazanyRadek = radek;
    }

    /// <summary>
    /// Otevře prázdný řádek nad daty.
    /// </summary>
    /// <remarks>
    /// Vyplnitelné sloupce se založí jako prázdné, aby v nich šlo psát a aby prázdné
    /// políčko šlo odlišit od NULL. Prázdné se pak do <c>INSERT</c> vůbec nedostane
    /// a uplatní se výchozí hodnota z databáze — proto ji políčko ukazuje v nápovědě.
    /// </remarks>
    private void ZacniVkladani()
    {
        Zrus();
        NovyRadek = true;

        foreach (var sloupec in Sloupce)
        {
            if (DuvodNevyplnitelnosti(sloupec) is null)
            {
                Editace[sloupec] = "";
            }
        }
    }

    /// <summary>Zahodí rozepsanou úpravu, nový řádek, potvrzení mazání i otevřenou nabídku.</summary>
    private void Zrus()
    {
        EditovanyRadek = null;
        MazanyRadek = null;
        NovyRadek = false;
        Nabidka = null;
        Editace.Clear();
    }

    /// <summary>Proč se sloupec nedá vyplnit u nového řádku.</summary>
    internal string? DuvodNevyplnitelnosti(string column) =>
        Table?.FindColumn(column) is { } sloupec
            ? RowEditing.NewRowReadOnlyReason(sloupec, Preview?.MaskedColumns)
            : Texts.ReasonColumnMissing;

    /// <summary>Co se do sloupce dostane, když ho uživatel nevyplní.</summary>
    private string Vychozi(string column) => Table?.FindColumn(column) switch
    {
        { DefaultValueSql: { Length: > 0 } sql } => sql,
        { IsNullable: true } => "NULL",
        _ => "",
    };

    private void ZmenHodnotu(string column, string? value) => Editace[column] = value ?? "";

    /// <summary>
    /// Přepnutí na NULL a zpátky. Zpátky se vrací prázdný řetězec, ne původní hodnota —
    /// ta už je pryč a tichý návrat k ní by uživatele mátl.
    /// </summary>
    private void PrepniNull(string column, bool naNull) => Editace[column] = naNull ? null : "";

    private async Task UlozAsync(int radek)
    {
        var row = Radky[radek];
        var zmeny = new List<DataValue>();

        for (var i = 0; i < Math.Min(row.Count, Sloupce.Count); i++)
        {
            var sloupec = Sloupce[i];

            // Posílají se jen skutečné změny. Přepsat celý řádek by zbytečně rozhýbalo
            // triggery i sloupce, na které uživatel nesáhl.
            if (Editace.TryGetValue(sloupec, out var nova) && nova != row[i])
            {
                zmeny.Add(new DataValue(sloupec, nova));
            }
        }

        if (zmeny.Count == 0)
        {
            Zrus();
            return;
        }

        await ZapisAsync(row, klic => OnUpdate!(new DataUpdate { Key = klic, Values = zmeny }));
    }

    private async Task SmazAsync(int radek) =>
        await ZapisAsync(Radky[radek], klic => OnDelete!(new DataDelete { Key = klic }));

    /// <summary>
    /// Vloží rozepsaný řádek. Posílají se jen vyplněné sloupce — u zbytku se nechá
    /// zapracovat výchozí hodnota z databáze.
    /// </summary>
    private async Task VlozAsync()
    {
        var hodnoty = Editace
            .Where(static e => e.Value is null || e.Value.Length > 0)
            .Select(static e => new DataValue(e.Key, e.Value))
            .ToList();

        if (hodnoty.Count == 0)
        {
            ChybaZapisu = Texts.NewRowEmpty;
            return;
        }

        ChybaZapisu = await OnInsert!(new DataInsert { Values = hodnoty });

        if (ChybaZapisu is null)
        {
            Zrus();
            await NactiAsync(Stranka);
        }
    }

    /// <summary>
    /// Společný průběh zápisu: sestaví klíč, zavolá server a po úspěchu načte stránku
    /// znovu — v databázi mohly zafungovat triggery i výchozí hodnoty.
    /// </summary>
    private async Task ZapisAsync(
        IReadOnlyList<string?> row,
        Func<IReadOnlyList<DataValue>, Task<string?>> operace)
    {
        var klic = Klic(row);

        if (klic.Count == 0)
        {
            ChybaZapisu = Texts.RowNotIdentifiable;
            return;
        }

        ChybaZapisu = await operace(klic);

        if (ChybaZapisu is null)
        {
            Zrus();
            await NactiAsync(Stranka);
        }
    }

    /// <summary>Hodnoty primárního klíče řádku. Prázdný seznam znamená „nejde určit".</summary>
    private IReadOnlyList<DataValue> Klic(IReadOnlyList<string?> row)
    {
        var klic = new List<DataValue>();

        foreach (var jmeno in Table?.PrimaryKey?.Columns ?? [])
        {
            var index = IndexSloupce(jmeno);

            if (index < 0 || index >= row.Count)
            {
                return [];
            }

            klic.Add(new DataValue(jmeno, row[index]));
        }

        return klic;
    }

    // ---------- podřízené záznamy ----------

    /// <summary>
    /// Odkazy nabízené u jedné buňky. Prázdné, když se z řádku nedá poskládat podmínka.
    /// </summary>
    /// <remarks>
    /// Rozepsaný řádek nabídku nedostane: kliknutí by odnavigovalo pryč a uživatel by
    /// o neuložené hodnoty přišel.
    /// </remarks>
    internal IReadOnlyList<ChildLink> OdkazyU(string column, int radek) =>
        EditovanyRadek is null && MazanyRadek is null && !NovyRadek
            ? [.. ChildLinks.At(Links, column).Where(o => Podminka(o, radek) is not null)]
            : [];

    /// <summary>
    /// Podmínka pro podřízenou tabulku, nebo <c>null</c>, když ji z řádku poskládat nejde.
    /// </summary>
    /// <remarks>
    /// Zamaskovaný sloupec se chová jako chybějící. V mřížce místo hodnoty stojí maska,
    /// takže by se filtrovalo podle hvězdiček a výsledek by byl vždy prázdný — a hlavně
    /// by odkaz předstíral, že hodnotu zná.
    /// </remarks>
    private IReadOnlyList<ChildFilter>? Podminka(ChildLink odkaz, int radek)
    {
        var row = Radky[radek];

        return odkaz.FilterFor(sloupec =>
        {
            var index = IndexSloupce(sloupec);

            return index >= 0 && index < row.Count && !IsMasked(sloupec) ? row[index] : null;
        });
    }

    /// <summary>Popis odkazu v nabídce: kam vede a přes které sloupce.</summary>
    internal static string Popis(ChildLink odkaz)
    {
        ArgumentNullException.ThrowIfNull(odkaz);

        return $"{odkaz.Table.Qualified} ({string.Join(", ", odkaz.Columns)})";
    }

    private bool JeNabidkaOtevrena(int radek, string sloupec) =>
        Nabidka is { } otevrena
        && otevrena.Radek == radek
        && string.Equals(otevrena.Sloupec, sloupec, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Kliknutí na šipku. Jediný cíl se otevře rovnou, u víc cílů se musí vybrat —
    /// nabídka s jedinou položkou by byla klik navíc bez užitku.
    /// </summary>
    private async Task OtevriDetiAsync(int radek, string sloupec, IReadOnlyList<ChildLink> odkazy)
    {
        if (odkazy.Count == 1)
        {
            await SkocAsync(odkazy[0], radek);
            return;
        }

        Nabidka = JeNabidkaOtevrena(radek, sloupec) ? null : (radek, sloupec);
    }

    private async Task SkocAsync(ChildLink odkaz, int radek)
    {
        Nabidka = null;

        if (Podminka(odkaz, radek) is { } podminka)
        {
            await OnShowChildren.InvokeAsync(new ChildJump(odkaz.Table, podminka));
        }
    }

    private async Task ZrusVazbu() => await OnClearLink.InvokeAsync();

    private int IndexSloupce(string column)
    {
        for (var i = 0; i < Sloupce.Count; i++)
        {
            if (string.Equals(Sloupce[i], column, StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }

        return -1;
    }
}
