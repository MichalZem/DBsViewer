@inject DbsViewerClient Client
@inject IJSRuntime Js
@inject NavigationManager Navigation
@implements IDisposable

@*
    Hlavní obrazovka. Stav je vytažený do ViewerState, aby se dal testovat bez vykreslování;
    tahle komponenta jen zprostředkovává volání serveru a překreslování.
*@

<div class="dbsviewer">

    @if (State.Meta.CanBrowseHistory && State.Migrations.Count > 0)
    {
        @*
            Přepínač verze je vidět pořád, ne jen když se člověk kouká do minulosti.
            Jinak by nebylo poznat, že se schéma dá prohlížet i zpětně — a cesta zpátky
            by se hledala hůř než cesta tam.
        *@
        <div class="verze-pruh @(State.IsHistorical ? "historicka" : "")">
            <label class="vyber">
                <span class="stitek">@(State.IsHistorical ? Texts.VersionHistorical : Texts.VersionLabel)</span>

                <select value="@(State.SelectedMigration ?? "")" @onchange="OnVerzeChangedAsync">
                    @*
                        Samotné „Aktuální schéma" nestačí: v seznamu verzí stojí vedle
                        jmen migrací a nebylo poznat, které z nich odpovídá.
                    *@
                    <option value="">@Texts.VersionCurrent@(PosledniAplikovanaPopis)</option>

                    @foreach (var migrace in VerzeOdNejnovejsi)
                    {
                        <option value="@migrace.Id" disabled="@(!migrace.HasSnapshot)">
                            @HistorieSchematu.Kratce(migrace.Id)@PoznamkaKVerzi(migrace)
                        </option>
                    }
                </select>
            </label>

            <label class="vyber vyber-zakladu">
                @*
                    Popisek říká směr: „co se změnilo od X" — tedy X je výchozí bod
                    a zobrazená verze je cíl. Bez toho nebylo z jednoho dropdownu poznat,
                    která strana je která, a člověk si směr domýšlel opačně.
                *@
                <span class="stitek">@Texts.ChangedSince</span>

                <select value="@(State.BaselineMigration ?? "")" @onchange="OnPorovnaniChangedAsync">
                    <option value="">@Texts.CompareNone</option>

                    @foreach (var migrace in VerzeOdNejnovejsi.Where(m => m.HasSnapshot))
                    {
                        <option value="@migrace.Id">@HistorieSchematu.Kratce(migrace.Id)</option>
                    }
                </select>
            </label>

            @if (State.JeVizualniPorovnani)
            {
                <span class="smer-porovnani">
                    <span class="mono">@(HistorieSchematu.Kratce(State.BaselineMigration) ?? "?")</span>
                    <span class="sipka">→</span>
                    <span class="mono">@ZobrazenaVerze</span>
                </span>

                <span class="legenda-zmen" title="@Texts.ChangeLegendHint">
                    <span class="vzorek pribylo">+</span> @Texts.ChangeAddedShort
                    <span class="vzorek ubylo">−</span> @Texts.ChangeRemovedShort
                    <span class="vzorek zmeneno">~</span> @Texts.ChangeModifiedShort
                </span>
            }
            else if (State.IsHistorical)
            {
                <span class="popis">@Texts.DataUnavailableHistorical</span>
            }

            @if (State.IsHistorical)
            {
                <button class="zpet-na-aktualni" @onclick="ZobrazAktualniAsync">
                    @Texts.BackToCurrent
                </button>
            }
        </div>
    }

    <header class="lista">
        <h1>@State.Meta.Title</h1>

        <nav class="pohledy">
            <button class="@Active(ViewerPane.Overview)" @onclick="() => SetPane(ViewerPane.Overview)">
                @Texts.TabOverview
            </button>
            <button class="@Active(ViewerPane.Browser)" @onclick="() => SetPane(ViewerPane.Browser)">
                @Texts.TabTables
            </button>
            <button class="@Active(ViewerPane.Diagram)" @onclick="() => SetPane(ViewerPane.Diagram)">
                @Texts.TabDiagram
            </button>
            @if (State.Meta.CanDiff)
            {
                <button class="@Active(ViewerPane.Diff)" @onclick="ShowDiffAsync">
                    @Texts.TabDifferences@(DiffBadge())
                </button>
            }
            @if (State.Meta.CanBrowseHistory)
            {
                <button class="@Active(ViewerPane.History)" @onclick="ShowHistoryAsync">
                    @Texts.TabHistory
                </button>
            }
        </nav>

        <div class="nastroje">
            @if (State.Meta.Views.Count > 1)
            {
                <select value="@State.Source" @onchange="OnSourceChangedAsync" title="@Texts.SchemaSource">
                    @foreach (var view in State.Meta.Views)
                    {
                        <option value="@view">@SourceLabel(view)</option>
                    }
                </select>
            }

            <select value="@(State.Group ?? "")" @onchange="OnGroupChanged" title="@Texts.TableGroup"
                    hidden="@(State.Meta.Groups.Count == 0)">
                <option value="">@Texts.AllGroups</option>
                @foreach (var group in State.Meta.Groups.Keys)
                {
                    <option value="@group">@group</option>
                }
            </select>

            @if (Schemas.Count > 1)
            {
                <select value="@(State.SchemaName ?? "")" @onchange="OnSchemaChanged" title="@Texts.SchemaLabel">
                    <option value="">@Texts.AllSchemas</option>
                    @foreach (var schema in Schemas)
                    {
                        <option value="@schema">@schema</option>
                    }
                </select>
            }

            <div class="export">
                <button @onclick="ToggleExport" title="@Texts.ExportTitle">@Texts.Export ▾</button>
                @if (_exportOtevreny)
                {
                    <ul class="export-nabidka">
                        @foreach (var format in Enum.GetValues<ExportFormat>())
                        {
                            <li>
                                <button @onclick="() => ExportAsync(format)">@format.ToString()</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <button @onclick="RefreshAsync" title="@Texts.RefreshTitle">@Texts.Refresh</button>

            <PrepinacJazyka />
        </div>
    </header>

    @if (State.Error is { } chyba)
    {
        <p class="chyba lista-chyba">@chyba</p>
    }

    @if (State.IsLoading)
    {
        <p class="nacita">@Texts.LoadingSchema</p>
    }
    else
    {
        <div class="obsah @(State.Pane == ViewerPane.Diagram ? "sirokych" : "")">

            @if (State.Pane == ViewerPane.History)
            {
                <HistorieSchematu Migrations="State.Migrations"
                                  SelectedMigration="@State.SelectedMigration"
                                  Diff="State.Diff"
                                  From="@State.CompareFrom"
                                  To="@State.CompareTo"
                                  OnSwitch="PrepniNaMigraciAsync"
                                  OnCompare="PorovnejMigraceAsync"
                                  OnRangeChange="ZmenRozsahPorovnani"
                                  OnCloseDiff="() => State.Diff = null"
                                  OnSelectTable="SelectFromOverviewAsync" />
            }
            else if (State.Pane == ViewerPane.Overview)
            {
                <PrehledDatabaze Schema="State.Schema" Summary="State.Summary" OnSelect="SelectFromOverviewAsync" />
            }
            else if (State.Pane == ViewerPane.Diff)
            {
                <DiffPrehled Diff="State.Diff" OnSelect="SelectAsync" />
            }
            else
            {
                <aside class="seznam">
                    <input type="search"
                           placeholder="@Texts.SearchPlaceholder"
                           value="@State.Search"
                           @oninput="OnSearchChanged" />

                    @*
                        Po předložce „z" je v češtině vždy genitiv plurálu, takže se tu
                        neskloňuje — proto zvláštní klíč a ne Counts.Tables.
                    *@
                    <p class="pocet">
                        @FilteredTables.Count @Texts.OfTotal
                        @State.DisplaySchema.Tables.Count @Texts.TablesGenitive
                    </p>

                    <ul>
                        @foreach (var table in FilteredTables)
                        {
                            var stavTabulky = State.Overlay.Tabulka(table.Name);

                            <li>
                                <button class="@(table.Name == State.SelectedTable ? "vybrana" : "") @SeverityClass(table.Name) @TableDetail.StavTridy(stavTabulky)"
                                        @onclick="() => SelectAsync(table.Name)">
                                    @if (table.Name.Schema is { Length: > 0 } schema)
                                    {
                                        <span class="schema-prefix" style="@SchemaBarvy.Styl(schema)"
                                              title="@Texts.SchemaLabel @schema">@schema<span class="tecka">.</span></span>
                                    }

                                    <span class="jmeno">@table.Name.Name</span>
                                    <span class="pocet-sloupcu">@table.Columns.Count</span>
                                </button>
                            </li>
                        }
                    </ul>
                </aside>

                <main class="hlavni-panel">
                    @if (State.Pane == ViewerPane.Diagram)
                    {
                        <div class="diagram-nastroje">
                            @if (JeVyrez)
                            {
                                @*
                                    Ve výřezu není z diagramu poznat, že zbytek schématu
                                    existuje. Cesta zpátky proto musí být vidět na první
                                    pohled, ne schovaná v zaškrtávátku.
                                *@
                                <button class="hlavni zpet-na-schema" @onclick="ZobrazCeleSchemaAsync">
                                    ← Celé schéma
                                </button>

                                <span class="vyrez-popis">
                                    Výřez kolem <strong>@State.SelectedTable!.Value.Name</strong>
                                </span>
                            }

                            <label>
                                <input type="checkbox"
                                       checked="@State.FocusEnabled"
                                       @onchange="OnFocusToggled" />
                                @Texts.FocusOnSelected
                            </label>

                            <label class="hops">
                                @Texts.FocusDistance @State.FocusHops
                                <input type="range" min="0" max="3" step="1"
                                       value="@State.FocusHops"
                                       disabled="@(!State.FocusEnabled)"
                                       @onchange="OnHopsChanged" />
                            </label>

                            <span class="pocet">
                                @Counts.Tables(DiagramTables.Count), @Counts.Relationships(Layout.Edges.Count)
                                @if (JeVyrez)
                                {
                                    <span class="z-celku">@Texts.OfTotal @Plural.Number(State.Schema.Tables.Count)</span>
                                }
                            </span>
                        </div>

                        <ErDiagram Layout="Layout"
                                   SelectedTable="State.SelectedTable"
                                   Expanded="State.ExpandedNodes"
                                   Overlay="State.Overlay"
                                   ShowSchemas="Schemas.Count > 1"
                                   SeverityOf="State.SeverityOf"
                                   OnSelect="SelectAsync"
                                   OnToggleExpand="ToggleExpand"
                                   CanPreviewData="State.Meta.CanPreviewData && !State.IsHistorical"
                                   OnShowData="ShowDataAsync" />
                    }
                    else
                    {
                        <TableDetail Table="State.SelectedDetail()"
                                     ActiveTab="State.Tab"
                                     Incoming="Incoming"
                                     Findings="Findings"
                                     Highlighted="Highlighted"
                                     CanPreviewData="State.Meta.CanPreviewData && !State.IsHistorical"
                                     IsHistorical="State.IsHistorical"
                                     Overlay="State.Overlay"
                                     Preview="_preview"
                                     PreviewError="@_previewChyba"
                                     OnTabChange="OnTabChanged"
                                     OnSelect="SelectAsync"
                                     CanEditData="State.Meta.CanEditData && !State.IsHistorical"
                                     CanDeleteData="State.Meta.CanDeleteData && !State.IsHistorical"
                                     CanInsertData="State.Meta.CanInsertData && !State.IsHistorical"
                                     OnLoadRows="LoadRowsAsync"
                                     OnUpdateRow="UpdateRowAsync"
                                     OnDeleteRow="DeleteRowAsync"
                                     OnInsertRow="InsertRowAsync" />
                    }
                </main>
            }
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _cancellation = new();

    private RowPreview? _preview;
    private string? _previewChyba;
    private bool _exportOtevreny;

    /// <summary>
    /// Adresa, kterou naposledy zapsala samotná prohlížečka.
    /// </summary>
    /// <remarks>
    /// Vlastní zápis adresy vyvolá <c>LocationChanged</c> stejně jako tlačítko Zpět.
    /// Bez tohohle porovnání by prohlížečka na každý svůj klik obnovovala stav z adresy,
    /// kterou právě sama složila — a rozdělaná práce, která v adrese není (načtený
    /// náhled dat), by se přitom zahodila.
    /// </remarks>
    private string? _posledniAdresa;

    /// <summary>Stav prohlížečky. Vystavený kvůli testům, které ho nastaví přímo.</summary>
    [Parameter]
    public ViewerState State { get; set; } = new();

    private IReadOnlyList<DbTable> FilteredTables => State.FilteredTables();

    private IReadOnlyList<DbTable> DiagramTables => State.DiagramTables();

    /// <summary>Kreslí se jen výřez kolem vybrané tabulky, ne celé schéma?</summary>
    private bool JeVyrez => State.FocusEnabled && State.SelectedTable is not null;

    /// <summary>
    /// Vrátí diagram na celé schéma. Výběr tabulky zůstane — zvýrazní se v celku,
    /// takže je vidět, odkud se člověk vrátil.
    /// </summary>
    private async Task ZobrazCeleSchemaAsync()
    {
        State.FocusEnabled = false;
        ZapisAdresu();

        await Task.CompletedTask;
    }

    private IReadOnlyList<string> Schemas => SchemaFilter.Schemas(State.Schema.Tables);

    private DiagramLayoutResult Layout =>
        DiagramLayout.Compute(DiagramTables, State.DiagramRelationships(), State.ExpandedNodes);

    private IReadOnlyList<DbRelationship> Incoming =>
        State.SelectedTable is { } table ? State.Graph.IncomingTo(table) : [];

    private IReadOnlyList<DiffFinding> Findings =>
        State.SelectedTable is { } table ? State.FindingsFor(table) : [];

    private IReadOnlySet<string> Highlighted =>
        State.SelectedDetail() is { } table
            ? SchemaFilter.MatchingColumns(table, State.Search)
            : new HashSet<string>();

    /// <summary>
    /// Nastartuje prohlížečku do stavu, který popisuje adresa.
    /// </summary>
    /// <remarks>
    /// Verze a zdroj schématu se musí nastavit ještě před načtením — podle nich se
    /// stahuje samotné schéma. Zbytek stavu se dá promítnout až nad načteným schématem,
    /// protože se v něm dohledávají jména tabulek.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += NaZmenuAdresy;

        var adresa = ViewerRoute.FromUri(Navigation.Uri);

        State.SelectedMigration = adresa.Version;
        State.Source = adresa.Source;

        await LoadAsync(refresh: false);
        await ObnovZbytekAsync(adresa);
    }

    /// <summary>
    /// Obnoví stav po tlačítku Zpět nebo Vpřed.
    /// </summary>
    /// <remarks>
    /// Vlastní zápis adresy se pozná podle <see cref="_posledniAdresa"/> a přeskočí —
    /// jinak by každý klik stav hned zase přepsal z adresy.
    /// </remarks>
    private void NaZmenuAdresy(object? sender, LocationChangedEventArgs e)
    {
        if (string.Equals(e.Location, _posledniAdresa, StringComparison.Ordinal))
        {
            return;
        }

        _ = InvokeAsync(() => ObnovZAdresyAsync(e.Location));
    }

    /// <summary>Promítne adresu do stavu. Schéma se dotahuje, jen když se změnila verze nebo zdroj.</summary>
    internal async Task ObnovZAdresyAsync(string uri)
    {
        var adresa = ViewerRoute.FromUri(uri);

        if (adresa.Version != State.SelectedMigration || adresa.Source != State.Source)
        {
            State.SelectedMigration = adresa.Version;
            State.Source = adresa.Source;
            State.Diff = null;

            await LoadAsync(refresh: false);
        }

        await ObnovZbytekAsync(adresa);

        StateHasChanged();
    }

    /// <summary>
    /// Promítne do stavu to, co jde až nad načteným schématem: základ porovnání, výběr
    /// tabulky a obsah panelu.
    /// </summary>
    private async Task ObnovZbytekAsync(ViewerRoute adresa)
    {
        // Základ porovnání musí být dřív než výběr tabulky: porovnání přidá do
        // zobrazeného schématu i tabulky, které mezitím zmizely, a výběr se hledá v něm.
        // Dotahuje se ze serveru, takže jen když se opravdu změnil — jinak by každé
        // Zpět stálo kolo na síti za schéma, které se už drží.
        if (adresa.Baseline != State.BaselineMigration)
        {
            await NastavZakladAsync(adresa.Baseline);
        }

        adresa.ApplyTo(State);

        if (State.Pane == ViewerPane.Diff)
        {
            await NactiDiffAsync();
        }
        else if (State.Pane == ViewerPane.History)
        {
            await DoplnHistoriiAsync();
        }
    }

    /// <summary>
    /// Zapíše stav do adresy, takže klik přidá záznam do historie prohlížeče.
    /// </summary>
    /// <remarks>
    /// <paramref name="nahradit"/> je pro filtry a hledání: každý znak v hledání by
    /// jinak byl vlastní krok historie a Zpět by se prokousávalo písmenko po písmenku.
    ///
    /// Adresa shodná s tou současnou se nezapisuje — jinak by opakovaný klik na už
    /// vybranou tabulku plnil historii stejnými záznamy.
    /// </remarks>
    private void ZapisAdresu(bool nahradit = false)
    {
        var cil = ViewerRoute.From(State).UrlFor(Navigation.Uri);

        if (string.Equals(cil, Navigation.Uri, StringComparison.Ordinal))
        {
            return;
        }

        _posledniAdresa = cil;

        Navigation.NavigateTo(cil, forceLoad: false, replace: nahradit);
    }

    /// <summary>Načte metadata i schéma. Chyba skončí hláškou v UI, ne výjimkou.</summary>
    internal async Task LoadAsync(bool refresh)
    {
        State.IsLoading = true;
        State.Error = null;

        try
        {
            State.Meta = await Client.GetMetaAsync(_cancellation.Token);

            if (State.Meta.Views.Count > 0 && !State.Meta.Views.Contains(State.Source))
            {
                State.Source = State.Meta.Views[^1];
            }

            State.Schema = State.SelectedMigration is { Length: > 0 } migrace
                ? await Client.GetSchemaAtMigrationAsync(migrace, _cancellation.Token)
                : await Client.GetSchemaAsync(State.Source, refresh, _cancellation.Token);

            if (State.Meta.CanBrowseHistory && State.Migrations.Count == 0)
            {
                State.Migrations = await Client.GetMigrationsAsync(_cancellation.Token);
            }

            _preview = null;
            _previewChyba = null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = Describe(ex);
        }
        finally
        {
            State.IsLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            await Client.RefreshAsync(_cancellation.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = Describe(ex);
            return;
        }

        await LoadAsync(refresh: true);
    }

    private async Task ShowDiffAsync()
    {
        State.Pane = ViewerPane.Diff;
        ZapisAdresu();

        await NactiDiffAsync();
    }

    /// <summary>Dotáhne nálezy diffu, pokud ještě nejsou.</summary>
    private async Task NactiDiffAsync()
    {
        if (State.Diff is not null)
        {
            return;
        }

        try
        {
            State.Diff = await Client.GetDiffAsync(false, _cancellation.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = Describe(ex);
        }
    }

    /// <summary>
    /// Uloží změněné hodnoty řádku. Vrací hlášku pro mřížku, ne výjimku — mřížka podle ní
    /// pozná, jestli má políčka zavřít, nebo nechat rozepsaná.
    /// </summary>
    internal Task<string?> UpdateRowAsync(DataUpdate update) =>
        ZapisAsync(table => Client.UpdateRowAsync(table, update, _cancellation.Token));

    /// <summary>Smaže řádek. Vrací hlášku pro mřížku, nebo <c>null</c> při úspěchu.</summary>
    internal Task<string?> DeleteRowAsync(DataDelete delete) =>
        ZapisAsync(table => Client.DeleteRowAsync(table, delete, _cancellation.Token));

    /// <summary>Vloží řádek. Vrací hlášku pro mřížku, nebo <c>null</c> při úspěchu.</summary>
    internal Task<string?> InsertRowAsync(DataInsert insert) =>
        ZapisAsync(table => Client.InsertRowAsync(table, insert, _cancellation.Token));

    private async Task<string?> ZapisAsync(Func<DbObjectName, Task<RowChange>> operace)
    {
        if (State.SelectedTable is not { } table)
        {
            return Texts.NoTableSelectedError;
        }

        try
        {
            await operace(table);
            return null;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return Describe(ex);
        }
    }

    internal async Task LoadRowsAsync(DataQuery? query = null)
    {
        if (State.SelectedTable is not { } table)
        {
            return;
        }

        _previewChyba = null;

        try
        {
            _preview = await Client.GetRowsAsync(table, query, _cancellation.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _previewChyba = Describe(ex);
        }
    }

    /// <summary>
    /// Kliknutí na tabulku v přehledu. Přepne na seznam — v přehledu samotném
    /// není detail kam vykreslit.
    /// </summary>
    private async Task SelectFromOverviewAsync(DbObjectName table)
    {
        State.Pane = ViewerPane.Browser;
        await SelectAsync(table);
    }

    /// <summary>
    /// Přechod z diagramu rovnou na data tabulky.
    /// </summary>
    /// <remarks>
    /// Z diagramu je nejčastější další otázka „a co v té tabulce je". Bez tohohle by se
    /// uživatel musel vracet do seznamu, tabulku najít znovu a přepnout záložku.
    /// </remarks>
    internal async Task ShowDataAsync(DbObjectName table)
    {
        Vyber(table);

        State.Pane = ViewerPane.Browser;
        State.Tab = DetailTab.Data;

        // Adresa se zapíše až nakonec, aby z jednoho kliknutí vznikl jeden krok
        // historie, ne tři — jinak by Zpět vracelo přes mezistavy, které uživatel
        // nikdy neviděl.
        ZapisAdresu();

        await Task.CompletedTask;
    }

    private async Task SelectAsync(DbObjectName table)
    {
        Vyber(table);
        ZapisAdresu();

        await Task.CompletedTask;
    }

    /// <summary>Vybere tabulku a zahodí načtený náhled dat. Adresu nechává na volajícím.</summary>
    private void Vyber(DbObjectName table)
    {
        State.Select(table);
        _preview = null;
        _previewChyba = null;

        if (State.Pane == ViewerPane.Diff)
        {
            State.Pane = ViewerPane.Browser;
        }
    }

    private void SetPane(ViewerPane pane)
    {
        State.Pane = pane;
        ZapisAdresu();
    }

    private void ToggleExpand(DbObjectName table)
    {
        State.ToggleExpanded(table);
        ZapisAdresu();
    }

    private void OnTabChanged(DetailTab tab)
    {
        State.Tab = tab;
        ZapisAdresu();
    }

    // Hledání a filtry adresu přepisují, ne přidávají: psaní do hledání by jinak
    // nasypalo do historie jeden záznam na každý znak.
    private void OnSearchChanged(ChangeEventArgs e)
    {
        State.Search = e.Value?.ToString() ?? "";
        ZapisAdresu(nahradit: true);
    }

    private void OnGroupChanged(ChangeEventArgs e)
    {
        State.Group = Empty(e.Value?.ToString());
        ZapisAdresu(nahradit: true);
    }

    private void OnSchemaChanged(ChangeEventArgs e)
    {
        State.SchemaName = Empty(e.Value?.ToString());
        ZapisAdresu(nahradit: true);
    }

    private void OnFocusToggled(ChangeEventArgs e)
    {
        State.FocusEnabled = e.Value is true;
        ZapisAdresu();
    }

    private void OnHopsChanged(ChangeEventArgs e)
    {
        State.FocusHops = int.TryParse(e.Value?.ToString(), out var hops) ? hops : State.FocusHops;
        ZapisAdresu();
    }

    private async Task OnSourceChangedAsync(ChangeEventArgs e)
    {
        State.Source = e.Value?.ToString() ?? State.Source;
        State.Diff = null;
        ZapisAdresu();

        await LoadAsync(refresh: false);
    }

    /// <summary>Otevře historii a dotáhne seznam migrací, pokud ještě není.</summary>
    internal async Task ShowHistoryAsync()
    {
        State.Pane = ViewerPane.History;
        State.Diff = null;
        ZapisAdresu();

        await DoplnHistoriiAsync();
    }

    /// <summary>Dotáhne seznam migrací a předvyplní porovnání poslední dvojice.</summary>
    private async Task DoplnHistoriiAsync()
    {
        try
        {
            if (State.Migrations.Count == 0)
            {
                State.Migrations = await Client.GetMigrationsAsync(_cancellation.Token);
            }

            // Předvyplní se porovnání poslední dvojice — to je nejčastější dotaz.
            // Musí to být mimo načítání: migrace už mohl dotáhnout LoadAsync.
            if (State.CompareTo is null && State.Migrations.Count > 0)
            {
                State.CompareTo = State.Migrations[^1].Id;

                State.CompareFrom = State.Migrations.Count > 1
                    ? State.Migrations[^2].Id
                    : null;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = Describe(ex);
        }
    }

    /// <summary>
    /// Přepne zobrazené schéma na stav po zadané migraci. Zbytek UI se nemění —
    /// přehled, seznam tabulek i diagram pracují se schématem, ať je z kdykoli.
    /// </summary>
    internal async Task PrepniNaMigraciAsync(string migrationId)
    {
        State.SelectedMigration = migrationId;
        ZapisAdresu();

        // Výběr tabulky ani rozbalené uzly se nezahazují — o to tu jde. Přepnutím
        // na jinou verzi se má změnit schéma, ne to, na co se člověk zrovna dívá.
        await LoadAsync(refresh: false);
    }

    /// <summary>
    /// Verze v pořadí od nejnovější. Migrace chodí ze serveru tak, jak se aplikují,
    /// ale v přepínači zajímá nejčastěji ta poslední.
    /// </summary>
    private IEnumerable<DbMigration> VerzeOdNejnovejsi => State.Migrations.Reverse();

    /// <summary>Jméno právě zobrazené verze — cíl porovnání.</summary>
    private string ZobrazenaVerze =>
        HistorieSchematu.Kratce(State.SelectedMigration)
        ?? (PosledniAplikovana is { } posledni
            ? $"{Texts.MigrationCurrent} ({HistorieSchematu.Kratce(posledni.Id)})"
            : Texts.MigrationCurrentSchema);

    /// <summary>
    /// Poslední migrace, která je opravdu v databázi — tomu odpovídá aktuální schéma.
    /// </summary>
    /// <remarks>
    /// Čekající migrace se nepočítají: jsou v kódu, ale databáze o nich neví, takže
    /// se v aktuálním schématu ještě neprojevily.
    /// </remarks>
    private DbMigration? PosledniAplikovana =>
        State.Migrations.LastOrDefault(static m => m.AppliedInDatabase);

    /// <summary>
    /// Poznámka za jménem migrace v seznamu verzí: která je poslední v databázi
    /// a která ještě čeká.
    /// </summary>
    private string PoznamkaKVerzi(DbMigration migrace)
    {
        if (!migrace.HasSnapshot)
        {
            return $" ({Texts.MigrationNoSnapshot})";
        }

        if (migrace.IsPending)
        {
            return $" ({Texts.MigrationPending})";
        }

        return migrace.Id == PosledniAplikovana?.Id ? $" (= {Texts.MigrationCurrentSchema})" : string.Empty;
    }

    /// <summary>Doplněk k popisku „Aktuální schéma" se jménem odpovídající migrace.</summary>
    private string PosledniAplikovanaPopis =>
        PosledniAplikovana is { } posledni
            ? $" — {Texts.AfterMigration} {HistorieSchematu.Kratce(posledni.Id)}"
            : string.Empty;

    /// <summary>
    /// Zapnutí nebo vypnutí vizuálního porovnání. Základ se načte celý, protože
    /// se z něj kreslí i to, co ve zobrazené verzi chybí.
    /// </summary>
    private async Task OnPorovnaniChangedAsync(ChangeEventArgs e)
    {
        await NastavZakladAsync(Empty(e.Value?.ToString()));

        // Až po načtení: když základ nejde dotáhnout, do adresy nemá co psát.
        ZapisAdresu();
    }

    /// <summary>
    /// Nastaví základ vizuálního porovnání. Prázdná hodnota porovnání vypne.
    /// </summary>
    private async Task NastavZakladAsync(string? migrace)
    {
        State.BaselineMigration = migrace;

        if (migrace is not { Length: > 0 } zaklad)
        {
            State.Baseline = null;
            return;
        }

        try
        {
            State.Baseline = await Client.GetSchemaAtMigrationAsync(zaklad, _cancellation.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.BaselineMigration = null;
            State.Baseline = null;
            State.Error = Describe(ex);
        }
    }

    /// <summary>Přepnutí verze z pruhu nahoře. Prázdná hodnota znamená aktuální schéma.</summary>
    private async Task OnVerzeChangedAsync(ChangeEventArgs e)
    {
        var vybrana = e.Value?.ToString();

        if (vybrana is { Length: > 0 })
        {
            await PrepniNaMigraciAsync(vybrana);
            return;
        }

        await ZobrazAktualniAsync();
    }

    /// <summary>Vrátí zobrazení na aktuální schéma.</summary>
    internal async Task ZobrazAktualniAsync()
    {
        State.SelectedMigration = null;
        ZapisAdresu();

        await LoadAsync(refresh: false);
    }

    internal async Task PorovnejMigraceAsync((string? From, string To) rozsah)
    {
        State.CompareFrom = rozsah.From;
        State.CompareTo = rozsah.To;

        try
        {
            State.Diff = await Client.CompareMigrationsAsync(
                rozsah.From, rozsah.To, _cancellation.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = Describe(ex);
        }
    }

    private void ZmenRozsahPorovnani((string? From, string? To) rozsah)
    {
        State.CompareFrom = rozsah.From;
        State.CompareTo = rozsah.To;
    }

    private void ToggleExport() => _exportOtevreny = !_exportOtevreny;

    /// <summary>
    /// Vyexportuje schéma a nabídne ke stažení. Soubor sestaví klient, takže se nic
    /// neposílá zpět na server.
    /// </summary>
    internal async Task ExportAsync(ExportFormat format)
    {
        _exportOtevreny = false;

        var content = SchemaExporter.Export(State.Schema, format);
        var fileName = $"schema.{SchemaExporter.FileExtension(format)}";

        try
        {
            await Js.InvokeVoidAsync("dbsviewer.download", _cancellation.Token, fileName, content);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            State.Error = $"{Texts.DownloadFailed} {ex.Message}";
        }
    }

    private string Active(ViewerPane pane) => State.Pane == pane ? "aktivni" : "";

    private string SeverityClass(DbObjectName table) => State.SeverityOf(table) switch
    {
        DiffSeverity.Error => "nalez-chyba",
        DiffSeverity.Warning => "nalez-varovani",
        _ => "",
    };

    private string DiffBadge() =>
        State.Diff is { } diff && !diff.IsClean ? $" ({diff.ErrorCount + diff.WarningCount})" : "";

    internal static string SourceLabel(string view) => view switch
    {
        "ef" => Texts.SourceEfModel,
        "live" => Texts.SourceDatabase,
        _ => Texts.SourceMerged,
    };

    /// <summary>Prázdná volba v rozbalovacím seznamu znamená „bez filtru".</summary>
    internal static string? Empty(string? value) => string.IsNullOrEmpty(value) ? null : value;

    /// <summary>Výjimka na text pro uživatele. Interní detaily se do UI nedostanou.</summary>
    internal static string Describe(Exception exception) => exception switch
    {
        DbsViewerClientException known => known.Message,
        HttpRequestException => Texts.ServerUnreachable,
        _ => Texts.SchemaLoadFailed,
    };

    public void Dispose()
    {
        Navigation.LocationChanged -= NaZmenuAdresy;

        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
