@*
    Úvodní přehled celé databáze. Nejdřív čísla, pak žebříčky a nakonec podněty —
    v tomhle pořadí se člověk v cizím schématu orientuje: kolik toho je, co je největší,
    a čeho si všimnout.
*@

<div class="prehled">

    <section class="prehled-cisla">
        <div class="karta">
            <span class="hodnota">@Plural.Number(Summary.TableCount)</span>
            <span class="popis">@Counts.TableForm(Summary.TableCount)</span>
        </div>

        @if (Summary.ViewCount > 0)
        {
            <div class="karta">
                <span class="hodnota">@Plural.Number(Summary.ViewCount)</span>
                <span class="popis">@Counts.ViewForm(Summary.ViewCount)</span>
            </div>
        }

        <div class="karta">
            <span class="hodnota">@Plural.Number(Summary.ColumnCount)</span>
            <span class="popis">@Counts.ColumnForm(Summary.ColumnCount)</span>
        </div>

        <div class="karta">
            <span class="hodnota">@Plural.Number(Summary.RelationshipCount)</span>
            <span class="popis">@Counts.RelationshipForm(Summary.RelationshipCount)</span>
        </div>

        <div class="karta">
            <span class="hodnota">@Plural.Number(Summary.IndexCount)</span>
            <span class="popis">@Counts.IndexForm(Summary.IndexCount)</span>
        </div>

        @if (Summary.TotalRowEstimate is { } radky)
        {
            <div class="karta">
                <span class="hodnota">@Plural.Number(radky)</span>
                <span class="popis">@Counts.RowForm(radky) @($" {Texts.RowsEstimate}")</span>
            </div>
        }
    </section>

    <section class="prehled-puvod">
        <dl>
            <dt>@Texts.Database</dt>
            <dd>@(Schema.DatabaseName ?? "—")</dd>

            <dt>@Texts.Source</dt>
            <dd>@(Schema.SourceName ?? Schema.Provider.ToString())</dd>

            @if (Summary.SchemaCount > 1)
            {
                <dt>@Texts.Schemas</dt>
                <dd>@string.Join(", ", Summary.BySchema.Select(s => $"{s.Schema ?? Texts.DefaultSchema} ({s.TableCount})"))</dd>
            }

            @if (Schema.Migrations.Count > 0)
            {
                <dt>@Texts.Migrations</dt>
                <dd>@Counts.AppliedMigrations(Schema.Migrations.Count), @Texts.LastMigration @Schema.Migrations[^1].Id</dd>
            }

            <dt>@Texts.LoadedAt</dt>
            <dd>@Schema.GeneratedAtUtc.ToLocalTime().ToString("d. M. yyyy H:mm", System.Globalization.CultureInfo.InvariantCulture)</dd>
        </dl>
    </section>

    @if (Schema.Warnings.Count > 0)
    {
        <section class="prehled-varovani">
            <h3>@Texts.WarningsHeading</h3>
            <ul>
                @foreach (var warning in Schema.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </section>
    }

    <div class="prehled-sloupce">

        @if (Summary.LargestTables.Count > 0)
        {
            <section class="prehled-zebricek">
                <h3>@Texts.LargestTables</h3>
                <ul>
                    @foreach (var item in Summary.LargestTables)
                    {
                        <li>
                            <button class="odkaz" @onclick="() => OnSelect.InvokeAsync(item.Table)">@item.Table.Qualified</button>
                            <span class="cislo">@Counts.Rows(item.Value)</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Summary.MostConnected.Count > 0)
        {
            <section class="prehled-zebricek">
                <h3>@Texts.MostConnected</h3>
                <ul>
                    @foreach (var item in Summary.MostConnected)
                    {
                        <li>
                            <button class="odkaz" @onclick="() => OnSelect.InvokeAsync(item.Table)">@item.Table.Qualified</button>
                            <span class="cislo">@Counts.Relationships((int)item.Value)</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Summary.CommonTypes.Count > 0)
        {
            <section class="prehled-zebricek">
                <h3>@Texts.MostCommonTypes</h3>
                <ul>
                    @foreach (var item in Summary.CommonTypes)
                    {
                        <li>
                            <span class="mono">@item.Type</span>
                            <span class="cislo">@Counts.Columns(item.Count)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <section class="prehled-podnety">
        <h3>@Texts.WorthAttention</h3>

        @if (!MaPodnety)
        {
            <p class="ok">✓ @Texts.NothingNotable</p>
        }
        else
        {
            <ul class="podnety">
                @if (Summary.WithoutPrimaryKey.Count > 0)
                {
                    <li>
                        <strong>@Texts.WithoutPrimaryKey</strong>
                        <span class="vysvetleni">@Texts.WithoutPrimaryKeyHint</span>
                        @Seznam(Summary.WithoutPrimaryKey)
                    </li>
                }

                @if (Summary.UnindexedForeignKeys.Count > 0)
                {
                    <li>
                        <strong>@Texts.ForeignKeyWithoutIndex</strong>
                        <span class="vysvetleni">@Texts.ForeignKeyWithoutIndexHint</span>
                        <ul class="hodnoty">
                            @foreach (var item in Summary.UnindexedForeignKeys.Take(ZobrazitNejvyse))
                            {
                                <li class="mono">@item</li>
                            }
                        </ul>
                        @Zbytek(Summary.UnindexedForeignKeys.Count)
                    </li>
                }

                @if (Summary.Isolated.Count > 0)
                {
                    <li>
                        <strong>Bez vazeb</strong>
                        <span class="vysvetleni">@Texts.IsolatedTableHint</span>
                        @Seznam(Summary.Isolated)
                    </li>
                }

                @if (Summary.JoinTableCount > 0)
                {
                    <li>
                        <strong>@Counts.JoinTables(Summary.JoinTableCount) N:M</strong>
                        <span class="vysvetleni">@Texts.JoinTableHint</span>
                    </li>
                }
            </ul>
        }
    </section>

</div>

@code {
    /// <summary>Kolik položek se ve výpisu ukáže, než se zbytek shrne číslem.</summary>
    private const int ZobrazitNejvyse = 8;

    /// <summary>Schéma, ze kterého přehled vychází.</summary>
    [Parameter, EditorRequired]
    public DatabaseSchema Schema { get; set; } = new();

    /// <summary>Spočítaný souhrn.</summary>
    [Parameter, EditorRequired]
    public SchemaSummary Summary { get; set; } = new();

    /// <summary>Kliknutí na tabulku v žebříčku.</summary>
    [Parameter]
    public EventCallback<DbObjectName> OnSelect { get; set; }

    private bool MaPodnety =>
        Summary.WithoutPrimaryKey.Count > 0
        || Summary.UnindexedForeignKeys.Count > 0
        || Summary.Isolated.Count > 0
        || Summary.JoinTableCount > 0;

    private RenderFragment Seznam(IReadOnlyList<DbObjectName> tables) => builder =>
    {
        builder.OpenElement(0, "ul");
        builder.AddAttribute(1, "class", "hodnoty");

        var poradi = 2;

        foreach (var table in tables.Take(ZobrazitNejvyse))
        {
            builder.OpenElement(poradi++, "li");
            builder.OpenElement(poradi++, "button");
            builder.AddAttribute(poradi++, "class", "odkaz");
            builder.AddAttribute(poradi++, "onclick",
                EventCallback.Factory.Create(this, () => OnSelect.InvokeAsync(table)));
            builder.AddContent(poradi++, table.Qualified);
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();

        if (tables.Count > ZobrazitNejvyse)
        {
            builder.AddContent(poradi, Zbytek(tables.Count));
        }
    };

    private RenderFragment? Zbytek(int celkem) => celkem <= ZobrazitNejvyse
        ? null
        : builder =>
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "zbytek");
            builder.AddContent(2, $"{Texts.AndMore} {Counts.Items(celkem - ZobrazitNejvyse)}");
            builder.CloseElement();
        };
}
