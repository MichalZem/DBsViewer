@*
    ER diagram jako SVG. Uzly jsou foreignObject s běžným HTML, takže se stylují CSS
    a mají normální hover i klik. Pan a zoom řeší jedna transformace na kořenové skupině.
*@

@if (Layout.Nodes.Count == 0)
{
    <p class="prazdno">Žádné tabulky k zobrazení. Zkus změnit filtr nebo vypnout focus.</p>
}
else
{
    <div class="diagram-plocha"
         @onwheel="OnWheel"
         @onwheel:preventDefault="true"
         @onpointerdown="OnPointerDown"
         @onpointermove="OnPointerMove"
         @onpointerup="OnPointerUp"
         @onpointerleave="OnPointerUp">

        <svg class="diagram" width="100%" height="100%">
            <defs>
                @*
                    markerUnits="userSpaceOnUse" drží hrot ve stejné velikosti bez ohledu
                    na tloušťku čáry. Bez toho se zvětšoval spolu s ní a u zvýrazněné
                    hrany narostl do nepoměru.
                *@
                <marker id="sipka" viewBox="0 0 12 10" refX="11" refY="5"
                        markerWidth="9" markerHeight="7.5"
                        markerUnits="userSpaceOnUse" orient="auto-start-reverse">
                    <path d="M 0.5 0.5 L 12 5 L 0.5 9.5 z" />
                </marker>
            </defs>

            <g transform="translate(@Fmt(_panX) @Fmt(_panY)) scale(@Fmt(_zoom))">

                @foreach (var edge in Layout.Edges)
                {
                    var relationship = edge.Relationship;

                    // Vybraná tabulka se odliší tím, že ostatní hrany zesvětlí. Dřív
                    // se místo toho zesilovala čára, jenže různá tloušťka se čte jako
                    // různá důležitost vazby, ne jako zvýraznění.
                    var prihlusena = SelectedTable is not null
                        && relationship.From != SelectedTable
                        && relationship.To != SelectedTable;

                    var stavHrany = Overlay.Vazba(relationship);

                    <g class="hrana @DeleteClass(relationship.DeleteBehavior) @(prihlusena ? "prihlusena" : "") @StavTridy(stavHrany)">
                        <path d="@EdgePath.Build(edge.Points)"
                              fill="none"
                              marker-end="url(#sipka)"
                              stroke-dasharray="@(relationship.IsRequired ? null : "5 4")" />
                        <text x="@Fmt(edge.LabelAt.X)" y="@Fmt(edge.LabelAt.Y - 6)" class="kardinalita">
                            @CardinalityLabel(relationship.Cardinality)
                        </text>
                    </g>
                }

                @foreach (var node in Layout.Nodes)
                {
                    var jeVybrany = node.Table.Name == SelectedTable;
                    var zavaznost = SeverityOf?.Invoke(node.Table.Name);
                    var stavUzlu = Overlay.Tabulka(node.Table.Name);

                    <foreignObject x="@Fmt(node.X)" y="@Fmt(node.Y)"
                                   width="@Fmt(node.Width)" height="@Fmt(node.Height)">
                        <div class="uzel @(jeVybrany ? "vybrany" : "") @SeverityClass(zavaznost) @StavTridy(stavUzlu)"
                             @onclick="() => OnSelect.InvokeAsync(node.Table.Name)">

                            <div class="uzel-hlavicka">
                                @if (StavZnak(stavUzlu) is { Length: > 0 } znakUzlu)
                                {
                                    <span class="znacka-zmeny" title="@StavPopis(stavUzlu)">@znakUzlu</span>
                                }

                                @if (ShowSchemas && node.Table.Name.Schema is { Length: > 0 } schemaName)
                                {
                                    @*
                                        Schéma je součástí jména, ne odznak vedle něj:
                                        v databázi s dbo.Orders i sales.Orders je „dbo.Orders"
                                        to, co člověk hledá. Barva pak nechá oko rozeznat
                                        celou skupinu dřív, než přečte prefix.
                                    *@
                                    <span class="uzel-schema" style="@SchemaBarvy.Styl(schemaName)"
                                          title="Schéma @schemaName">@schemaName<span class="tecka">.</span></span>
                                }

                                <span class="uzel-jmeno">@node.Table.Name.Name</span>
                                @if (node.Table.IsJoinTable)
                                {
                                    <span class="odznak" title="Vazební tabulka N:M">N:M</span>
                                }
                                @if (node.Table.IsView)
                                {
                                    <span class="odznak" title="Pohled">VIEW</span>
                                }
                                @if (CanPreviewData)
                                {
                                    @*
                                        Odkaz rovnou na data. Z diagramu je nejčastější další
                                        krok „a co je v té tabulce", a bez tohohle se musí přes
                                        seznam vlevo a záložku Data.
                                    *@
                                    <button class="uzel-data"
                                            title="Zobrazit data tabulky @node.Table.Name.Name"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OnShowData.InvokeAsync(node.Table.Name)">▤</button>
                                }
                                <button class="uzel-prepinac"
                                        title="Zobrazit všechny sloupce"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OnToggleExpand.InvokeAsync(node.Table.Name)">
                                    @(IsExpanded(node.Table.Name) ? "−" : "+")
                                </button>
                            </div>

                            <div class="uzel-sloupce">
                                @foreach (var column in DiagramLayout.VisibleColumns(
                                    node.Table, IsExpanded(node.Table.Name)))
                                {
                                    var stavSloupce = Overlay.Sloupec(node.Table.Name, column.Name);

                                    <div class="uzel-sloupec @(column.IsPrimaryKey ? "pk" : "") @StavTridy(stavSloupce)">
                                        <span class="klic">@KeyMark(column)</span>
                                        <span class="jmeno">@column.Name</span>
                                        <span class="typ">@column.StoreType</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </foreignObject>
                }
            </g>
        </svg>

        <div class="diagram-ovladani">
            <button title="Přiblížit" @onclick="() => Zoom(1.2)">+</button>
            <button title="Oddálit" @onclick="() => Zoom(1 / 1.2)">−</button>
            <button title="Původní velikost" @onclick="ResetView">⌂</button>
            <span class="zoom-hodnota">@((int)(_zoom * 100)) %</span>
        </div>

        <div class="diagram-legenda @(_legendaOtevrena ? "" : "sbalena")">
            @if (_legendaOtevrena)
            {
                <span class="nadpis">Vysvětlivky</span>

                <span class="polozka">
                    <span class="vzorek kaskada"></span>
                    Mazání rodiče smaže i potomky (CASCADE)
                </span>
                <span class="polozka">
                    <span class="vzorek setnull"></span>
                    Mazání rodiče vynuluje cizí klíč (SET NULL)
                </span>
                <span class="polozka">
                    <span class="vzorek restrict"></span>
                    Mazání rodiče databáze odmítne
                </span>
                <span class="polozka">
                    <span class="vzorek nepovinna"></span>
                    Přerušovaně: nepovinná vazba (cizí klíč smí být NULL)
                </span>
                <span class="polozka">
                    <span class="vzorek restrict"></span>
                    Šipka míří na tabulku, na kterou se odkazuje
                </span>

                <span class="polozka">1:N, 1:1, N:M — kardinalita vazby</span>
            }

            <button class="prepinac" @onclick="() => _legendaOtevrena = !_legendaOtevrena">
                @(_legendaOtevrena ? "Skrýt vysvětlivky" : "Vysvětlivky")
            </button>
        </div>
    </div>
}

@code {
    private bool _legendaOtevrena;
    private double _panX;
    private double _panY;
    private double _zoom = 1;
    private bool _tahne;
    private double _tahX;
    private double _tahY;

    /// <summary>Spočítané rozložení diagramu.</summary>
    [Parameter, EditorRequired]
    public DiagramLayoutResult Layout { get; set; } = new() { Nodes = [], Edges = [] };

    /// <summary>Vybraná tabulka — zvýrazní se i s jejími hranami.</summary>
    [Parameter]
    public DbObjectName? SelectedTable { get; set; }

    /// <summary>Uzly zobrazené se všemi sloupci.</summary>
    [Parameter]
    public IReadOnlySet<DbObjectName> Expanded { get; set; } = new HashSet<DbObjectName>();

    /// <summary>
    /// Vrstva změn oproti porovnávané verzi. Bez porovnání označuje vše jako beze změny.
    /// </summary>
    [Parameter]
    public SchemaOverlay Overlay { get; set; } = SchemaOverlay.None(new DatabaseSchema());

    /// <summary>
    /// Ukazovat u uzlů jméno databázového schématu. Zapíná se, až když je schémat víc —
    /// u jediného by štítek jen zabíral místo.
    /// </summary>
    [Parameter]
    public bool ShowSchemas { get; set; }

    /// <summary>Nabízet v hlavičce uzlu odkaz na data tabulky?</summary>
    [Parameter]
    public bool CanPreviewData { get; set; }

    /// <summary>Kliknutí na odkaz na data.</summary>
    [Parameter]
    public EventCallback<DbObjectName> OnShowData { get; set; }

    /// <summary>CSS třída podle stavu změny.</summary>
    internal static string StavTridy(ZmenaStav stav) => stav switch
    {
        ZmenaStav.Pribylo => "zmena-pribylo",
        ZmenaStav.Ubylo => "zmena-ubylo",
        ZmenaStav.Zmeneno => "zmena-zmeneno",
        _ => "",
    };

    /// <summary>Znak před jménem tabulky. U nezměněné prázdný.</summary>
    internal static string StavZnak(ZmenaStav stav) => stav switch
    {
        ZmenaStav.Pribylo => "+",
        ZmenaStav.Ubylo => "−",
        ZmenaStav.Zmeneno => "~",
        _ => "",
    };

    internal static string? StavPopis(ZmenaStav stav) => stav switch
    {
        ZmenaStav.Pribylo => "Přibylo oproti porovnávané verzi",
        ZmenaStav.Ubylo => "V porovnávané verzi bylo, teď už není",
        ZmenaStav.Zmeneno => "Změnilo se oproti porovnávané verzi",
        _ => null,
    };

    /// <summary>Závažnost nálezu diffu pro tabulku, pro barevné orámování uzlu.</summary>
    [Parameter]
    public Func<DbObjectName, DiffSeverity?>? SeverityOf { get; set; }

    [Parameter]
    public EventCallback<DbObjectName> OnSelect { get; set; }

    [Parameter]
    public EventCallback<DbObjectName> OnToggleExpand { get; set; }

    private bool IsExpanded(DbObjectName table) => Expanded.Contains(table);

    private void Zoom(double factor) => _zoom = Math.Clamp(_zoom * factor, 0.2, 3);

    private void ResetView()
    {
        _zoom = 1;
        _panX = 0;
        _panY = 0;
    }

    private void OnWheel(WheelEventArgs e) => Zoom(e.DeltaY < 0 ? 1.1 : 1 / 1.1);

    private void OnPointerDown(PointerEventArgs e)
    {
        _tahne = true;
        _tahX = e.ClientX;
        _tahY = e.ClientY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!_tahne)
        {
            return;
        }

        _panX += e.ClientX - _tahX;
        _panY += e.ClientY - _tahY;
        _tahX = e.ClientX;
        _tahY = e.ClientY;
    }

    private void OnPointerUp(PointerEventArgs e) => _tahne = false;

    /// <summary>Čísla do SVG vždy s tečkou — desetinná čárka by atribut rozbila.</summary>
    internal static string Fmt(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    internal static string CardinalityLabel(DbCardinality cardinality) => cardinality switch
    {
        DbCardinality.ManyToMany => "N:M",
        DbCardinality.OneToOne => "1:1",
        _ => "1:N",
    };

    /// <summary>Kaskády jsou to, co člověk v cizím schématu hledá nejčastěji — mají vlastní barvu.</summary>
    internal static string DeleteClass(DbDeleteBehavior behavior) => behavior switch
    {
        DbDeleteBehavior.Cascade => "kaskada",
        DbDeleteBehavior.SetNull or DbDeleteBehavior.SetDefault => "setnull",
        _ => "restrict",
    };

    internal static string SeverityClass(DiffSeverity? severity) => severity switch
    {
        DiffSeverity.Error => "nalez-chyba",
        DiffSeverity.Warning => "nalez-varovani",
        _ => "",
    };

    internal static string KeyMark(DbColumn column) => column switch
    {
        { IsPrimaryKey: true, IsForeignKey: true } => "PF",
        { IsPrimaryKey: true } => "PK",
        { IsForeignKey: true } => "FK",
        _ => "",
    };
}
