<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup Label="Pokrytí kódu">
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,lcov,json</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)../../artifacts/coverage/server/</CoverletOutput>
    <Include>[DbsViewer.Server]*</Include>
    <SkipAutoProps>true</SkipAutoProps>
    <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <Threshold>100,100,85</Threshold>
    <ThresholdType>line,method,branch</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbsViewer.Server\DbsViewer.Server.csproj" />
    <ProjectReference Include="..\..\src\DbsViewer.EfCore\DbsViewer.EfCore.csproj" />
    <ProjectReference Include="..\..\src\DbsViewer.Sqlite\DbsViewer.Sqlite.csproj" />
    <ProjectReference Include="..\..\samples\DbsViewer.SampleShop\DbsViewer.SampleShop.csproj" />
    <ProjectReference Include="..\DbsViewer.TestKit\DbsViewer.TestKit.csproj" />
  </ItemGroup>

  <!--
    Náhrada UI pro testy servírování souborů. Skutečné UI se do testovací sestavy
    nevkládá (trvalo by to a nic navíc by neověřilo), ale cesty a typy obsahu
    otestovat jde jen proti nějakým souborům.
  -->
  <ItemGroup>
    <EmbeddedResource Include="FakeUi/index.html" LogicalName="DbsViewer.Server.ui.index.html" />
    <EmbeddedResource Include="FakeUi/dbsviewer.css" LogicalName="DbsViewer.Server.ui.dbsviewer.css" />
    <EmbeddedResource Include="FakeUi/blazor.webassembly.js"
                      LogicalName="DbsViewer.Server.ui._framework.blazor.webassembly.js" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
