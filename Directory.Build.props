<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Michal Zemek</Authors>
    <Product>DbsViewer</Product>
    <Copyright>Copyright (c) Michal Zemek</Copyright>
    <PackageProjectUrl>https://github.com/MichalZem/DBsViewer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MichalZem/DBsViewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>ef-core;database;schema;er-diagram;documentation;blazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ikona.png</PackageIcon>
  </PropertyGroup>

  <!--
    Na stránce balíčku se ukazuje zvláštní README, ne to hlavní: v hlavním jsou
    relativní odkazy do repozitáře (docs/adr/…), které by na nuget.org vedly nikam.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/README-balicek.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/ikona.png" Pack="true" PackagePath="ikona.png" Visible="false" />
  </ItemGroup>

  <!--
    SourceLink je od .NET 8 součástí SDK, takže stačí zapnout. Díky němu se dá
    v laděné aplikaci vkročit do zdrojů balíčku. Symboly jdou na nuget.org zvlášť
    jako .snupkg, aby samotný balíček nenabobtnal.
  -->
  <PropertyGroup Label="Ladění a reprodukovatelnost">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Verze se odvozuje z git tagů, ne z čísla v souboru. Tag v1.2.3 vydá verzi 1.2.3;
    commit za ním dostane 1.2.4-alpha.0.N, takže každý build z main má vlastní verzi
    a nesnaží se přepsat už publikovanou.
  -->
  <PropertyGroup Label="Verzování">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
