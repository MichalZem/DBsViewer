<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Centrální správa verzí vyžaduje explicitní mapování zdrojů (NU1507).
       Až se budou publikovat vlastní balíčky, přidá se sem interní feed
       s patternem DbsViewer.* -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
